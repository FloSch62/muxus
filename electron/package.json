{
  "name": "@muxus/electron",
  "version": "0.8.0",
  "private": true,
  "description": "Muxus desktop app",
  "license": "MIT",
  "homepage": "https://github.com/FloSch62/muxus",
  "author": {
    "name": "Florian Schwarz",
    "email": "schwarz.flori.88@gmail.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "desktopName": "muxus.desktop",
  "scripts": {
    "build": "node scripts/render-icon.mjs && node esbuild.config.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty,@serialport/bindings-cpp",
    "pack:dir": "electron-builder --dir",
    "dist": "node scripts/dist.mjs",
    "dist:store": "node scripts/dist.mjs --win appx --x64"
  },
  "dependencies": {
    "@muxus/shared": "workspace:*",
    "@napi-rs/keyring": "^2.1.0",
    "@serialport/bindings-cpp": "13.0.1",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring-darwin-arm64": "2.1.0",
    "@napi-rs/keyring-darwin-x64": "2.1.0",
    "@napi-rs/keyring-linux-arm-gnueabihf": "2.1.0",
    "@napi-rs/keyring-linux-arm64-gnu": "2.1.0",
    "@napi-rs/keyring-linux-arm64-musl": "2.1.0",
    "@napi-rs/keyring-linux-riscv64-gnu": "2.1.0",
    "@napi-rs/keyring-linux-x64-gnu": "2.1.0",
    "@napi-rs/keyring-linux-x64-musl": "2.1.0",
    "@napi-rs/keyring-win32-arm64-msvc": "2.1.0",
    "@napi-rs/keyring-win32-ia32-msvc": "2.1.0",
    "@napi-rs/keyring-win32-x64-msvc": "2.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@muxus/server": "workspace:*",
    "@types/node": "^26.6.2",
    "electron": "44.4.5",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "shell-env": "^4.0.3",
    "typescript": "^7.0.2"
  }
}

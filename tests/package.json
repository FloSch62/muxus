    "ssh2": "^1.17.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3",
    "@types/bun": "^1.4.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@playwright/test": "^1.62.1"
  }
}

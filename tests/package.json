{
  "name": "@muxus/tests",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "exit 0",
    "build": "exit 0",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun node_modules/vitest/vitest.mjs run",

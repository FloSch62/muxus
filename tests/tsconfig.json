{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM"],
    "noEmit": true,
    "declaration": false,
    "types": ["node"],
    "paths": {
      "@muxus/shared": ["../shared/src/index.ts"],
      "@muxus/shared/ws-protocol": ["../shared/src/ws-protocol.ts"]
    }
  },
  // Ambient typings for untyped client dependencies the tests reach.
  "include": ["unit", "vitest.config.ts", "../client/src/remote-desktop/novnc.d.ts"]
}

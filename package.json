{
  "name": "muxus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "description": "Free, open-source SSH client & terminal — kitty graphics, split-pane sessions, SFTP, port forwarding",
  "license": "MIT",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "check:bundle": "pnpm --filter @muxus/client build && pnpm --filter @muxus/client check:bundle",
    "start": "node server/dist/index.js",
    "electron": "pnpm build && pnpm --filter @muxus/electron start",
    "dist": "pnpm build && pnpm --filter @muxus/electron dist",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @muxus/tests test",
    "test:watch": "pnpm --filter @muxus/tests test:watch",
    "test:coverage": "pnpm --filter @muxus/tests test:coverage",
    "lint": "oxlint . --deny-warnings"
  },
  "devDependencies": {
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
